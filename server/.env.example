# PostgreSQL connection string (Railway: use the Postgres service's DATABASE_URL reference variable)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Set to "false" only for a local Postgres without TLS (tests / local dev)
DATABASE_SSL=true
PORT=5000
# Telegram bot token - REQUIRED: used to verify Telegram WebApp initData on every request
BOT_TOKEN=
# Max age of Telegram initData in seconds (default 86400 = 24h)
INITDATA_MAX_AGE_SECONDS=86400
# Comma-separated exact CORS origins (unset = https://glax-miner.vercel.app only).
# Add http://localhost:5173 for local frontend development.
ALLOWED_ORIGINS=https://glax-miner.vercel.app
