# Copy to app/.env.local (untracked). Never put a bot token here.

# API base URL (defaults to https://glaxminer-production.up.railway.app)
VITE_API_URL=

# LOCAL DEVELOPMENT ONLY (ignored by production builds): a real Telegram
# WebApp initData string from a TEST bot, so the app can run in a normal
# browser. The API must use that test bot's BOT_TOKEN, and its
# ALLOWED_ORIGINS must include http://localhost:5173.
VITE_DEV_INIT_DATA=
