# Telegram bot token from @BotFather (must be the same token the API server uses as BOT_TOKEN)
BOT_TOKEN=

# Optional: test an unreleased build inside Telegram with /preview.
# PREVIEW_WEB_APP_URL = the Vercel preview URL
# PREVIEW_USER_IDS    = comma-separated Telegram user IDs allowed to use /preview
PREVIEW_WEB_APP_URL=
PREVIEW_USER_IDS=
